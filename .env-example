# Copy this file to .env and fill in the values. Never commit .env.

# --- How to get your OpenRouter key ---
# 1. Create an account at https://openrouter.ai
# 2. Open the "Keys" page from your account menu
# 3. Click "Create Key" and give it a name
# 4. Copy the key (it is shown only once)
# 5. Paste it below, after the "="
OPENROUTER_API_KEY=your_key_here

# Primary model. Check current model IDs at https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Comma-separated fallbacks, used if the primary fails or takes > 20 s.
# You can add a ":free" model here.
OPENROUTER_FALLBACKS=anthropic/claude-haiku-4.5

# Optional limits (defaults shown)
# LLM_TIMEOUT=20
# DAILY_REQUEST_CAP=50
# MAX_TOOL_STEPS=6
# RUN_TOKEN_BUDGET=20000
# CHAT_TOKEN_BUDGET=3000
# PRICE_PER_1K_TOKENS=0.006
